// Aiwork — Framework Modular de Agentes IA para PyMEs
// Base de datos: PostgreSQL (compatible con Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Conexión de la app: en producción suele ir por un pooler (Supabase :6543).
  url       = env("DATABASE_URL")
  // Conexión directa (:5432) que Prisma necesita para migraciones y shadow DB.
  // En local puede ser idéntica a DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AgentStatus {
  ACTIVE
  INACTIVE
  BETA
}

enum KnowledgeType {
  FAQ
  SERVICE
  POLICY
  PRICING
  DOCUMENT
  OTHER
}

enum KnowledgeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CustomerStatus {
  NEW // Nuevo
  CONTACTED // Contactado
  APPOINTMENT_REQUESTED // Cita solicitada
  APPOINTMENT_CONFIRMED // Cita confirmada
  QUOTE_REQUESTED // Cotización solicitada
  QUOTE_SENT // Cotización enviada
  FOLLOW_UP // En seguimiento
  CONVERTED // Convertido
  LOST // Perdido
}

enum CustomerSource {
  WEB_CHAT
  DASHBOARD
  WHATSAPP
  EMAIL
  REFERRAL
  OTHER
}

enum Channel {
  WEB_CHAT
  DASHBOARD
  WHATSAPP // preparado para el futuro
  EMAIL // preparado para el futuro
}

enum ConversationStatus {
  OPEN
  HANDLED_BY_AI
  NEEDS_HUMAN
  CLOSED
}

enum MessageSender {
  CUSTOMER
  AGENT
  SYSTEM
  USER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING // Pendiente
  IN_PROGRESS // En progreso
  COMPLETED // Completada
  OVERDUE // Vencida
  CANCELLED // Cancelada
}

enum AppointmentStatus {
  REQUESTED // Solicitada
  CONFIRMED // Confirmada
  RESCHEDULED // Reagendada
  CANCELLED // Cancelada
  COMPLETED // Completada
}

enum QuoteStatus {
  DRAFT // Borrador
  SENT // Enviada
  APPROVED // Aprobada
  REJECTED // Rechazada
  NEEDS_ADJUSTMENT // Requiere ajuste
}

enum MetricEventType {
  CONVERSATION_STARTED
  MESSAGE_RECEIVED
  AI_RESPONSE
  LEAD_CREATED
  APPOINTMENT_REQUESTED
  APPOINTMENT_CONFIRMED
  QUOTE_CREATED
  QUOTE_SENT
  TASK_CREATED
  TASK_COMPLETED
  FOLLOW_UP_CREATED
}

// ---------------------------------------------------------------------------
// Modelos
// ---------------------------------------------------------------------------

model Company {
  id   String @id @default(cuid())
  name String
  /// Identificador del chat público: /chat/<slug>.
  slug String @unique
  /// Dominio propio que sirve el chat de esta empresa (sin www ni puerto).
  chatDomain    String?  @unique
  industry      String?
  description   String?
  phone         String?
  email         String?
  website       String?
  address       String?
  businessHours String?
  tone          String?  @default("profesional y cercano")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users            User[]
  companyAgents    CompanyAgent[]
  knowledgeSources KnowledgeSource[]
  customers        Customer[]
  conversations    Conversation[]
  tasks            Task[]
  appointments     Appointment[]
  quotes           Quote[]
  metricEvents     MetricEvent[]

  @@map("companies")
}

model User {
  id           String     @id @default(cuid())
  companyId    String
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(OPERATOR)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("users")
}

/// Catálogo global de agentes disponibles en la plataforma.
model Agent {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  department    String
  description   String
  defaultPrompt String
  basePrice     Decimal     @default(0) @db.Decimal(10, 2)
  status        AgentStatus @default(ACTIVE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  companyAgents CompanyAgent[]
  conversations Conversation[]
  tasks         Task[]

  @@map("agents")
}

/// Agentes activados por empresa, con su configuración propia.
model CompanyAgent {
  id            String   @id @default(cuid())
  companyId     String
  agentId       String
  customPrompt  String?
  configuration Json?
  monthlyLimit  Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([companyId, agentId])
  @@index([companyId])
  @@map("company_agents")
}

model KnowledgeSource {
  id        String          @id @default(cuid())
  companyId String
  title     String
  type      KnowledgeType   @default(FAQ)
  content   String
  status    KnowledgeStatus @default(PUBLISHED)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("knowledge_sources")
}

model Customer {
  id              String         @id @default(cuid())
  companyId       String
  name            String
  phone           String?
  email           String?
  serviceInterest String?
  source          CustomerSource @default(WEB_CHAT)
  status          CustomerStatus @default(NEW)
  notes           String?
  lastContactAt   DateTime?
  nextActionAt    DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  tasks         Task[]
  appointments  Appointment[]
  quotes        Quote[]

  @@index([companyId, status])
  @@map("customers")
}

model Conversation {
  id         String             @id @default(cuid())
  companyId  String
  customerId String?
  agentId    String?
  channel    Channel            @default(WEB_CHAT)
  status     ConversationStatus @default(OPEN)
  summary    String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  agent    Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([companyId, createdAt])
  @@map("conversations")
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  sender         MessageSender
  content        String
  metadata       Json?
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Task {
  id          String       @id @default(cuid())
  companyId   String
  customerId  String?
  agentId     String?
  title       String
  description String?
  dueDate     DateTime?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  agent    Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@map("tasks")
}

model Appointment {
  id            String            @id @default(cuid())
  companyId     String
  customerId    String
  service       String
  requestedDate DateTime
  confirmedDate DateTime?
  status        AppointmentStatus @default(REQUESTED)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@map("appointments")
}

model Quote {
  id          String      @id @default(cuid())
  companyId   String
  customerId  String
  service     String
  description String?
  amount      Decimal     @db.Decimal(10, 2)
  currency    String      @default("MXN")
  status      QuoteStatus @default(DRAFT)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@map("quotes")
}

model MetricEvent {
  id        String          @id @default(cuid())
  companyId String
  type      MetricEventType
  value     Float           @default(1)
  metadata  Json?
  createdAt DateTime        @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, type, createdAt])
  @@map("metric_events")
}
