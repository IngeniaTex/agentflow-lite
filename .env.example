# Base de datos PostgreSQL (compatible con Supabase)
# Alternativa sin instalar nada: npm i -D embedded-postgres && npm run db:local
#   DATABASE_URL="postgresql://agentflow:agentflow@localhost:55432/agentflow_lite"
DATABASE_URL="postgresql://user:password@localhost:5432/agentflow_lite"
# Conexión directa para migraciones (Supabase: puerto 5432, sin pgbouncer).
# En local puede ser la misma que DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/agentflow_lite"

# Autenticación (NextAuth / Auth.js)
# Genera un secreto con: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-secure-random-secret"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-secure-random-secret"
AUTH_TRUST_HOST="true"

# IA — proveedor activo: "anthropic", "openai" o "mock".
# Si se deja vacío se autodetecta: Anthropic si hay llave, luego OpenAI, luego mock.
# Un proveedor sin su llave cae al modo mock en lugar de fallar.
AI_PROVIDER="anthropic"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Email (preparado para el futuro)
RESEND_API_KEY=""
EMAIL_FROM="noreply@example.com"

# App
NEXT_PUBLIC_APP_NAME="Aiwork"
NEXT_PUBLIC_DEMO_COMPANY_ID="demo-company-001"

# Límites del chat público (opcionales)
CHAT_RATE_LIMIT_PER_IP="10"
CHAT_RATE_LIMIT_WINDOW_MS="600000"
CHAT_RATE_LIMIT_GLOBAL_DAILY="300"
